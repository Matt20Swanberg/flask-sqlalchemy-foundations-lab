
# ==========================================
# Operating System Files
# ==========================================

.DS_Store
Thumbs.db


# ==========================================
# Python Cache and Compiled Files
# ==========================================

__pycache__/
*.py[cod]
*$py.class


# ==========================================
# Python Virtual Environments
# ==========================================

.venv/
venv/
env/
ENV/


# ==========================================
# Pytest and Testing
# ==========================================

.pytest_cache/
.coverage
htmlcov/
.tox/

# Learn-specific test results
.results.json


# ==========================================
# Flask and SQLite Databases
# ==========================================

# Ignore generated SQLite databases
*.db
*.sqlite
*.sqlite3
*.sqlite3-*

# Ignore SQLite temporary files
*.db-journal
*.db-wal
*.db-shm

# Ignore Flask instance data
instance/

# Existing database directory rules
/db/*.sqlite3
/db/*.sqlite3-*


# ==========================================
# Environment Variables and Secrets
# ==========================================

.env
.env.*
!.env.example

# Rails master key
/config/master.key


# ==========================================
# IDE and Editor Settings
# ==========================================

.vscode/
.idea/
*.swp
*.swo
*~


# ==========================================
# Logs and Temporary Files
# ==========================================

/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

*.log

# Runtime data
pids
*.pid
*.seed
.byebug_history


# ==========================================
# Uploaded Files
# ==========================================

/storage/*
!/storage/.keep


# ==========================================
# Ruby / Bundler
# ==========================================

.bundle/


# ==========================================
# Node.js and JavaScript
# ==========================================

node_modules/
jspm_packages/
.npm/
.node_repl_history
package-lock.json

# Compiled binary addons
build/Release/

# Instrumented libraries
lib-cov/


# ==========================================
# SQLAlchemy / Alembic
# ==========================================

# IMPORTANT:
# Keep migrations/ and migrations/versions/
# tracked in Git to preserve database history.

# Ignore generated Python caches within migrations
migrations/**/__pycache__/
